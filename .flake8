[flake8]
max-line-length = 88
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist
per-file-ignores =
    # Notebooks converted to scripts may have unused imports at top
    notebooks/*.py: F401
ignore =
    # W503: line break before binary operator (conflicts with Black)
    W503
